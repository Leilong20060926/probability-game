# 複製為 .env 後填入實際值；不要提交真實密碼。
PORT=5174
DB_PATH=backend/data/game.db

# 正式環境（有 HTTPS 終止）設為 true，cookie 才會帶 Secure。
# 本機 http 開發請保持 false，否則瀏覽器會拒絕設定 cookie。
COOKIE_SECURE=false

# 組員登入帳號；密碼雜湊用
#   node backend/scripts/hash-password.mjs "你的密碼"
# 產生，貼到下面，不要寫明文密碼。
ADMIN_USERNAME=team
ADMIN_PASSWORD_HASH=123
